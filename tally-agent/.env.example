# Copy this file to ".env" and fill in the values.

# Your cloud backend address (no trailing slash)
CLOUD_URL=https://api.gopiramsarees.in

# The shared secret. MUST exactly match the SYNC_AGENT_TOKEN set on the server (Railway).
SYNC_TOKEN=paste-the-same-token-as-on-the-server

# Tally's local address (default is correct for Tally on the same PC)
TALLY_URL=http://localhost:9000

# How often to sync, in minutes
INTERVAL_MINUTES=5

# How often to force a FULL resync, in minutes (default 60). Between full
# resyncs the agent syncs incrementally — it only re-reads stock when Tally
# reports a new voucher, and ledgers when a master changes, so most cycles are
# a fast heartbeat. The periodic full resync self-heals and propagates deletions.
FULL_RESYNC_MINUTES=60
